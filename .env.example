# Kopieer dit bestand naar .env en vul in.
# Development: SQLite, geen verdere configuratie nodig.
# Productie: PostgreSQL-connectiestring (BOUWOPDRACHT.md §1) — zelfde schema, andere provider.
DATABASE_URL="file:./dev.db"

# Auth.js sessietoken-sleutel. Genereer een eigen willekeurige waarde, bv. met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="vul-hier-een-willekeurige-string-in"
