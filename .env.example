# Kopieer dit bestand naar .env en vul in.
#
# PostgreSQL (Neon, of een andere host). Neon geeft twee connectiestrings:
# een "pooled" (via PgBouncer, voor de app zelf) en een directe (voor
# migraties). DATABASE_URL is de pooled variant, DIRECT_URL de directe.
DATABASE_URL="postgresql://gebruiker:wachtwoord@ep-iets-pooler.regio.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://gebruiker:wachtwoord@ep-iets.regio.aws.neon.tech/neondb?sslmode=require"

# Auth.js sessietoken-sleutel. Genereer een eigen willekeurige waarde, bv. met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="vul-hier-een-willekeurige-string-in"

# Wachtwoorden voor het eigenaar- en traineraccount. De seed maakt die
# accounts alleen aan als deze hier staan (minimaal 12 tekens) — er staan
# echte klantnamen in de app, dus geen standaardwachtwoorden.
# Een bestaand account wordt nooit overschreven: wijzigen doe je later in de
# app zelf, niet via deze variabelen.
OWNER_PASSWORD="kies-een-sterk-wachtwoord"
TRAINER_PASSWORD="kies-een-ander-sterk-wachtwoord"
